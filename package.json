{
  "name": "ngx-mol-viewers",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:demo": "ng serve demo-showcase",
    "build:demo": "./bin/build-demo.js",
    "start:demo:prod": "npx live-server --mount='/ngx-mol-viewers/:./docs' --open=/ngx-mol-viewers/",
    "build:libs": "run-p build:libs:*",
    "build:libs:structure-viewer": "ng build -c=production ngx-structure-viewer",
    "build:libs:sequence-viewer": "ng build -c=production ngx-sequence-viewer",
    "build:libs:features-viewer": "ng build -c=production ngx-features-viewer",
    "publish": "run-p publish:*",
    "publish:structure-viewer": "npm publish ./dist/ngx-structure-viewer",
    "publish:sequence-viewer": "npm publish ./dist/ngx-sequence-viewer",
    "publish:features-viewer": "npm publish ./dist/ngx-features-viewer",
    "serve:docs": "live-server --mount='/ngx-mol-viewers/:./docs' --no-browser ./docs",
    "changesets": "npx @changesets/cli",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint"
  },
  "bin": {
    "bd": "bin/build-demo.js"
  },
  "workspaces": [
    "projects/*"
  ],
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.11",
    "@angular/common": "^17.3.11",
    "@angular/compiler": "^17.3.11",
    "@angular/core": "^17.3.11",
    "@angular/forms": "^17.3.11",
    "@angular/platform-browser": "^17.3.11",
    "@angular/platform-browser-dynamic": "^17.3.11",
    "@angular/router": "^17.3.11",
    "@types/d3": "^7.4.3",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "d3": "^7.9.0",
    "live-server": "^1.2.2",
    "molstar": "^4.4.1",
    "rxjs": "~7.8.1",
    "tslib": "^2.6.3",
    "uuid": "^10.0.0",
    "zone.js": "~0.14.7"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.8",
    "@angular-eslint/builder": "17.5.2",
    "@angular-eslint/eslint-plugin": "17.5.2",
    "@angular-eslint/eslint-plugin-template": "17.5.2",
    "@angular-eslint/schematics": "17.5.2",
    "@angular-eslint/template-parser": "17.5.2",
    "@angular/cli": "^17.3.8",
    "@angular/compiler-cli": "^17.3.11",
    "@types/jasmine": "~5.1.4",
    "@types/node": "^20.14.13",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "engine.io": "^6.5.5",
    "eslint": "^8.57.0",
    "jasmine-core": "~5.1.2",
    "karma": "~6.4.3",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^17.3.0",
    "socket.io-adapter": "^2.5.5",
    "typedoc": "^0.25.13",
    "typescript": "~5.4.5",
    "webpack-dev-server": "^5.0.4"
  }
}
